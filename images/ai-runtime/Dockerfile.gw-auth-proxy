FROM golang:1.26.5 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/gw-auth-proxy ./cmd/gw-auth-proxy

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/gw-auth-proxy /gw-auth-proxy
USER 65532:65532
ENTRYPOINT ["/gw-auth-proxy"]
