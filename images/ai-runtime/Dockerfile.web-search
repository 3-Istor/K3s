FROM golang:1.26.5 AS build
ARG VERSION=dev
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X main.version=${VERSION}" -o /out/web-search ./cmd/web-search

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/web-search /web-search
USER 65532:65532
EXPOSE 3000
ENTRYPOINT ["/web-search"]
