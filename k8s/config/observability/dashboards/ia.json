    "list": [
      {
        "name": "project",
        "label": "Projet",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(cnp:ai_requests_total, project)",
          "refId": "P"
        },
        "definition": "label_values(cnp:ai_requests_total, project)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "eur_per_usd",
        "label": "EUR pour 1 USD",
        "type": "textbox",
        "query": "0.86",
        "current": {
          "text": "0.86",
          "value": "0.86"
        },
        "description": "Taux de change appliqué aux prix Anthropic (USD)."
      }
    ]
  },
  "panels": [
