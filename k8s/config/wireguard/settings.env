# Tunnel AWS 100.96.0.0/30: AWS .1, on-prem .2 (no overlap with Cilium 10.0.0.0/8, services 10.43.0.0/16, AWS 172.31.0.0/16)
ONPREM_TUNNEL_ADDRESS=100.96.0.2/30
CLOUD_TUNNEL_IP=100.96.0.1
MTU=1380

# Published by Terraform on every EKS up (Cloud repo, module cluster-addons)
CLOUD_ENDPOINT_URL=https://cnp-wireguard-endpoints-757826.s3.eu-west-3.amazonaws.com/aws
CLOUD_PUBLIC_KEY=62gLvSF1F/oUTRYfH7qAIuSAqpnFZG0hxU4yEF/KU2w=

# onprem-to-cloud: aws-apps.wireguard.svc:18081 -> AWS tunnel IP:18081
ONPREM_TO_CLOUD_PORT=18081
# cloud-to-onprem: AWS target 100.96.0.2:18080 -> this on-prem service
CLOUD_TO_ONPREM_PORT=18080
CLOUD_TO_ONPREM_TARGET=whoami.wireguard.svc.cluster.local:80
