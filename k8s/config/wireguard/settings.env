# Tunnel 100.96.0.0/30: AWS .1, on-prem .2 (no overlap with Cilium 10.0.0.0/8, services 10.43.0.0/16, AWS 172.31.0.0/16)
ONPREM_TUNNEL_ADDRESS=100.96.0.2/30
AWS_TUNNEL_IP=100.96.0.1
MTU=1380

# Filled from the output of `./cnp vpn` on the AWS side; empty = wg0 up without peer
AWS_ENDPOINT=13.51.241.248:31820
AWS_PUBLIC_KEY=62gLvSF1F/oUTRYfH7qAIuSAqpnFZG0hxU4yEF/KU2w=

# onprem-to-aws: aws-apps.wireguard.svc:18081 -> AWS tunnel IP:18081 (AWS listen_port)
ONPREM_TO_AWS_PORT=18081
# aws-to-onprem: AWS target 100.96.0.2:18080 -> this on-prem service
AWS_TO_ONPREM_PORT=18080
AWS_TO_ONPREM_TARGET=whoami.wireguard.svc.cluster.local:80
