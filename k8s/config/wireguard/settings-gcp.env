# Tunnel GKE 100.96.0.4/30: GKE .5, on-prem .6
ONPREM_TUNNEL_ADDRESS=100.96.0.6/30
CLOUD_TUNNEL_IP=100.96.0.5
MTU=1380

# Published by Terraform on every GKE up (Cloud repo, module cluster-addons)
CLOUD_ENDPOINT_URL=https://cnp-wireguard-endpoints-757826.s3.eu-west-3.amazonaws.com/gcp
CLOUD_PUBLIC_KEY=IFleh6EEHQkfuxIU9UoiSHPPCQpPP/D2bFjHsYI/+1A=

# onprem-to-cloud: gcp-apps.wireguard.svc:18081 -> GKE tunnel IP:18081
ONPREM_TO_CLOUD_PORT=18081
# cloud-to-onprem: <tunnel IP>:port -> in-cluster service, space-separated port=host:port
CLOUD_TO_ONPREM_FLOWS=18080=vm-victoria-metrics-cluster-vminsert.observability.svc.cluster.local:8480 18082=loki-gateway.observability.svc.cluster.local:80 18083=vm-victoria-metrics-cluster-vmselect.observability.svc.cluster.local:8481
